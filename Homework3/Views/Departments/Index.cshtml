@model IReadOnlyList<Department>
@{
    ViewData["Title"] = "Кафедры";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">Справочная таблица</p>
        <h1>Кафедры</h1>
    </div>
    <a class="button primary" asp-action="Create">Добавить кафедру</a>
</div>
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert error">@error</div>
}
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Название кафедры</th>
            <th class="actions">Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (Department department in Model)
    {
        <tr>
            <td>@department.Id</td>
            <td>@department.Name</td>
            <td class="actions">
                <a asp-action="Edit" asp-route-id="@department.Id">Изменить</a>
                <a class="danger-link" asp-action="Delete" asp-route-id="@department.Id">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>
