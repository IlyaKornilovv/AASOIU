@model Teacher
@{
    ViewData["Title"] = "Добавление преподавателя";
}
<h1>Добавление преподавателя</h1>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="validation"></span>

    <label asp-for="DepartmentId"></label>
    <select asp-for="DepartmentId" asp-items="ViewBag.Departments">
        <option value="0">— выберите кафедру —</option>
    </select>
    <span asp-validation-for="DepartmentId" class="validation"></span>

    <label asp-for="Publications"></label>
    <input asp-for="Publications" min="0" />
    <span asp-validation-for="Publications" class="validation"></span>

    <div class="form-actions">
        <button class="button primary" type="submit">Сохранить</button>
        <a class="button" asp-action="Index">Отмена</a>
    </div>
</form>
